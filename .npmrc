# Scope -> GitHub Packages registry
@oleg-irchishyn:registry=https://npm.pkg.github.com

# Auth token is read from the NODE_AUTH_TOKEN env var (never commit a real token).
# Local:  set NODE_AUTH_TOKEN to a GitHub PAT (classic) with read:packages (+ write:packages to publish)
# CI:     GitHub Actions provides it via secrets.GITHUB_TOKEN
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# Enforce engine constraints (node/pnpm versions)
engine-strict=true

# Hoist type definitions, peer dependencies, and build-tool packages project-wide (pnpm strict mode)
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=@mui/*
public-hoist-pattern[]=@emotion/*
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=@storybook/*
