# Set the registry for @gen2fund scope
@gen2fund:registry=https://pkgs.dev.azure.com/gen2fundprod/_packaging/gen2fund-packages/npm/registry/

# Always authenticate when accessing this registry
always-auth=true

# Enforce engine constraints (node/pnpm versions)
engine-strict=true

# Hoist type definitions, peer dependencies, and build-tool packages project-wide (pnpm strict mode)
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=@mui/*
public-hoist-pattern[]=@emotion/*
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=@storybook/*

# Note: Authentication is handled by:
# - Local development: Use `vsts-npm-auth` or Azure CLI (`az artifacts npm login`)
# - CI/CD Pipeline: Automatically handled by Azure Pipelines service connection