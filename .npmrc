# Set the registry for @gen2fund scope
@gen2fund:registry=https://pkgs.dev.azure.com/gen2fundprod/_packaging/gen2fund-packages/npm/registry/

# Always authenticate when accessing this registry
always-auth=true

# Note: Authentication is handled by:
