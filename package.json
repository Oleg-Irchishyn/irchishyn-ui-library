{
  "name": "@gen2fund/gen2verse-ui-library",
  "version": "1.4.5",
  "description": "Gen2Verse UI component library",
  "license": "UNLICENSED",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/generate-coverage-md.cjs",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "type-check": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "peerDependencies": {
    "@emotion/react": ">=11",
    "@emotion/styled": ">=11",
    "@mui/material": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": "^22.14.0 || >=24.10.0"
  },
  "dependencies": {
    "@gen2fund/platform.style": "^0.2.0",
    "@mui/x-date-pickers": "^8.27.2",
    "ag-grid-community": "^34.2.0",
    "ag-grid-enterprise": "^34.3.1",
    "ag-grid-react": "^34.2.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@storybook/addon-docs": "^8.6.17",
    "@storybook/addon-essentials": "^8.6.17",
    "@storybook/blocks": "^8.6.17",
    "@storybook/react-vite": "^8.6.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.2.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.0.0",
    "storybook": "^8.6.17",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
