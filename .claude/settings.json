{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/.git/**)",
      "Write(**/.env)",
      "Write(**/.env.*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-write.mjs\"",
            "statusMessage": "Running Prettier, ESLint, TypeScript check..."
          }
        ]
      }
    ]
  }
}
